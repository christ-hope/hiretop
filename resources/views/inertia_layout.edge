<!DOCTYPE html>
<html>

  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title inertia>
      {{ title ?? 'hireTop' }}
    </title>
    <link rel="preconnect" href="https://fonts.bunny.net" />
    <link
      href="https://fonts.bunny.net/css?family=poppins:100,200,300,400,500,600,700,800,900"
      rel="stylesheet"
    />
    <script src="https://cdn.tailwindcss.com">

    </script>

    @stack('dumper')
    @viteReactRefresh()
    @inertiaHead()
    @vite([
      'resources/css/app.css',
      'inertia/app/app.tsx',
      `inertia/pages/${page.component}.tsx`
    ])

  </head>

  <body class="min-h-screen w-screen font-poppins">
    @inertia()
  </body>

</html>
